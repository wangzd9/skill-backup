+def test_external_worker_without_future_is_never_reclaimed_by_age(tmp_path, monkeypatch):
+    """Real native ledger + live PID: an external worker need not have a Future."""
+    import cron.executions as executions
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(sched, '_get_hermes_home', lambda: tmp_path)
+    monkeypatch.setattr(executions, 'EXECUTIONS_FILE', tmp_path/'cron'/'executions.db')
+    job = _job('external-worker', minutes=5)
+    _inject_stale_claim(job['id'], tmp_path)
+    worker = subprocess.Popen(['sleep', '60'])
+    try:
+        row = executions.create_execution(job['id'], source='event')
+        with executions._transaction() as db:
+            db.execute('UPDATE executions SET status=?,pid=?,process_started_at=? WHERE id=?',
+                       ('running', worker.pid, executions._process_start_time(worker.pid), row['id']))
+        with patch.object(sched, 'mark_job_run') as mark:
+            assert sched.sweep_stale_inflight([job]) == []
+            assert job['id'] in sched.get_running_job_ids()
+            mark.assert_not_called()
+        # Unknown fingerprint is protected, too. Death, unlike age, permits recovery.
+        with executions._transaction() as db:
+            db.execute('UPDATE executions SET process_started_at=NULL WHERE id=?', (row['id'],))
+        assert sched.sweep_stale_inflight([job]) == []
+        worker.terminate(); worker.wait(timeout=5)
+        with patch.object(sched, 'mark_job_run'):
+            assert sched.sweep_stale_inflight([job]) == [job['id']]
+    finally:
+        if worker.poll() is None:
+            worker.terminate(); worker.wait(timeout=5)
+
